# Docker Compose settings (copy this file to .env).
TZ=Europe/Berlin
POLICYWEB_PORT=8080

# Host directory containing the generated Netspoc export used during the
# migration to the native policy engine. An absolute path is recommended.
NETSPOC_DATA=./docker/netspoc-data

# SMTP credentials referenced by docker/policyweb.conf.
POLICYWEB_SMTP_USERNAME=policyweb
POLICYWEB_SMTP_PASSWORD=replace-with-smtp-password

# FortiGate token referenced by token_env in docker/policyweb.conf.
EDGE_1_API_TOKEN=replace-with-fortigate-api-token

# FortiManager credentials referenced by username_env/password_env in
# docker/policyweb.conf.
FMG_API_USER=netspoc-web
FMG_API_PASSWORD=replace-with-fortimanager-password
