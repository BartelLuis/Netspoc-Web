# Docker Compose settings (copy this file to .env).
TZ=Europe/Berlin
POLICYWEB_BIND=127.0.0.1
POLICYWEB_PORT=8080

# Required once for the initial administrator publication. Replace with a long,
# random value and remove it after bootstrap has completed.
POLICYWEB_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-secret

# Keep both false only for the initial local HTTP setup. Set both true when the
# application is served exclusively through a trusted TLS reverse proxy.
POLICYWEB_COOKIE_SECURE=false
POLICYWEB_TRUST_PROXY_HEADERS=false

# Host directory containing the generated Netspoc export used during the
# migration to the native policy engine. An absolute path is recommended.
NETSPOC_DATA=./docker/netspoc-data

# SMTP credentials referenced by docker/policyweb.conf.
POLICYWEB_SMTP_USERNAME=policyweb
POLICYWEB_SMTP_PASSWORD=replace-with-smtp-password

# FortiGate token referenced by token_env in docker/policyweb.conf.
EDGE_1_API_TOKEN=replace-with-fortigate-api-token

# FortiManager credentials referenced by username_env/password_env in
# docker/policyweb.conf.
FMG_API_USER=netspoc-web
FMG_API_PASSWORD=replace-with-fortimanager-password

# Read-only service account used only by the manual LDAP user sync.
POLICYWEB_LDAP_BIND_DN=CN=policyweb-sync,OU=Service Accounts,DC=example,DC=org
POLICYWEB_LDAP_BIND_PASSWORD=replace-with-ldap-password
